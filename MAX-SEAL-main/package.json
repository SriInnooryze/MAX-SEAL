{
  "name": "max-seal-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-catalog.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-catalog.mjs",
    "build": "vite build && node -e \"import('fs').then(fs => fs.copyFileSync('dist/index.html', 'dist/404.html'))\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "catalog:migrate": "node scripts/migrate-to-excel.mjs",
